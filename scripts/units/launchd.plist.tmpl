<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.otto.{name}</string>
  <key>ProgramArguments</key><array>
    <string>{python}</string><string>{runner}</string><string>{name}</string>
  </array>
  <key>StartCalendarInterval</key><array>{intervals}</array>
  <key>StandardOutPath</key><string>{home}/state/{name}.out.log</string>
  <key>StandardErrorPath</key><string>{home}/state/{name}.err.log</string>
</dict></plist>
